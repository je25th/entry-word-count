{
	"name": "entry-word-count",
	"version": "1.0.0",
	"description": "Record each entry's date and word count in the note, and see the writing section's word count in the status bar.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
